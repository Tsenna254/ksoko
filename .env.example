# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1

# --- Production (all required when DJANGO_DEBUG is not 1) ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
# IP_HASH_SALT=
# DJANGO_ALLOWED_HOSTS=shop.example.com
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
# SITE_URL=https://shop.example.com
# DATABASE_URL=postgres://user:password@localhost:5432/ksoko
# REDIS_URL=redis://localhost:6379/1
# ADMIN_URL=backstage-change-me/
# TRUST_PROXY_HEADERS=1

# --- Email for verification codes ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Ksoko <no-reply@shop.example.com>

# --- Payments ---
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_SECRET=
# FLW_SECRET_KEY=

# --- Render (set these in the Render dashboard or let render.yaml set them; see README) ---
# MEDIA_ROOT=/var/data/media            # folder on a persistent disk
# AWS_STORAGE_BUCKET_NAME=...           # or S3-compatible storage instead of a disk (R2, S3, Backblaze)
# AWS_S3_ENDPOINT_URL=...  AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...  AWS_S3_CUSTOM_DOMAIN=...
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend   # email over HTTPS if your host blocks SMTP
# ANYMAIL_BREVO_API_KEY=...
# TRUSTED_PROXY_COUNT=1
